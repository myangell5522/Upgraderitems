Configs: {
	UpgraderServerConfig: {
		DisplayName: Правила апгрейдера

		Headers: {
			Odds: Шансы
			Rules: Правила
			Categories: Категории
		}

		HouseEdge: {
			Label: Комиссия заведения
			Tooltip: Честный шанс — это ценность ставки / ценность цели. Значение умножает его: 0.9 означает 90% от честного шанса.
		}

		MaxChance: {
			Label: Максимальный шанс
			Tooltip: Верхний предел шанса успеха.
		}

		MinChance: {
			Label: Минимальный шанс
			Tooltip: Нижний предел, чтобы даже безумные цели теоретически выпадали.
		}

		FailureRefund: {
			Label: Возврат при проигрыше
			Tooltip: Доля цены продажи потерянного предмета, возвращаемая монетами. 0 — полная потеря.
		}

		ProtectFavoritedItems: {
			Label: Защищать избранные предметы
			Tooltip: Избранные предметы нельзя поставить. Настоятельно рекомендуется.
		}

		AllowInMultiplayer: {
			Label: Разрешить в мультиплеере
			Tooltip: Выключите, чтобы отключить апгрейдер на сервере.
		}

		CooldownTicks: {
			Label: Перезарядка (тики)
			Tooltip: Задержка между апгрейдами. 60 тиков — одна секунда.
		}

		StrictCategories: {
			Label: Строгие категории
			Tooltip: Оружие только в оружие, броня в броню, аксессуар в аксессуар. Выключите, чтобы разрешить всё.
		}
	}

	UpgraderClientConfig: {
		DisplayName: Интерфейс апгрейдера

		Headers: {
			Tooltip: Подсказки
			Interface: Интерфейс
		}

		ShowValueInTooltip: {
			Label: Показывать ценность в подсказках
			Tooltip: ""
		}

		ShowStackValueInTooltip: {
			Label: Показывать сумму за стак
			Tooltip: Добавляет вторую строку с ценностью всего стака.
		}

		AnimateTooltipIcon: {
			Label: Анимировать монету
			Tooltip: ""
		}

		TooltipIconFrameTicks: {
			Label: Скорость вращения монеты
			Tooltip: Тиков на кадр. Больше — медленнее.
		}

		TooltipIconSize: {
			Label: Размер монеты
			Tooltip: Целые шаги сохраняют пиксельную чёткость.
		}

		ShowInventoryButton: {
			Label: Показывать кнопку в инвентаре
			Tooltip: ПКМ-перетаскиванием кнопку можно перенести.
		}

		PlaySounds: {
			Label: Звуковые эффекты
			Tooltip: ""
		}

		SpinDurationTicks: {
			Label: Длительность прокрутки (тики)
			Tooltip: Сколько крутится колесо до показа результата.
		}

		ScreenShakeOnResult: {
			Label: Тряска экрана при результате
			Tooltip: ""
		}
	}
}

